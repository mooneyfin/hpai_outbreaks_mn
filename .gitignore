# ---- DATA ----
# All raw/processed data files are hosted on Zenodo (see README.md).
# Only folder structure, documentation, and key RDS objects are tracked.
data/**
!data/.keep
!data/confidential/
!data/confidential/README.md
!data/confidential/.keep
!data/raw/
!data/raw/.keep
!data/raw/feedlot_data/.keep
!data/raw/meteorological_data/.keep
!data/raw/bird_abundance_data/.keep
!data/raw/spatial_data/.keep
!data/file_locations/
!data/file_locations/file_locations.R
!data/objects/
!data/objects/objects.R
!data/objects/dataframes/
!data/objects/dataframes/*.RDS
!data/objects/dataframes/*.rds
!data/objects/dataframes/.keep
# These two are ~194MB each — too large for GitHub, available on Zenodo
data/objects/dataframes/fishnet_timeseries.RDS
data/objects/dataframes/fishnet_timeseries_modeling.RDS
!data/objects/models/
!data/objects/models/*.RDS
!data/objects/models/.keep
!data/processed/
!data/processed/.keep

# Archive folder (old script versions, not part of pipeline)
code/Archive/

# Empty placeholder folders (not tracked)
output/
reports/
code/analysis/
code/model_prep/

# Manuscript / supporting docs (not part of the analysis repo)
*.pdf
Supporting Information*.docx
